# CareConnect AI - Environment Configuration Example
PROJECT_NAME="CareConnect AI"
API_V1_STR="/api"
DEFAULT_CITY="Indore"

# Security
JWT_SECRET="careconnect-ai-indore-healthcare-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite, for PostgreSQL: postgresql://user:password@localhost:5432/careconnect)
DATABASE_URL="sqlite:///./careconnect.db"

# Optional Caching and External Services
REDIS_URL="redis://localhost:6379/0"
LLM_API_KEY="your-gemini-or-openai-api-key-here"
MAPS_API_KEY="your-google-maps-or-mapbox-api-key-here"
SMS_API_KEY="your-msg91-or-twilio-api-key-here"
EMAIL_API_KEY="your-sendgrid-or-ses-api-key-here"
PAYMENT_API_KEY="your-razorpay-or-stripe-key-here"
